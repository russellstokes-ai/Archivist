# Example only: copy this file to deploy/nas/nas.env and edit real host paths.
# These must be existing paths visible to Docker, not container paths.
# For Synology: /volume1/Books ; Unraid: /mnt/user/Books ;
# TrueNAS: /mnt/pool/Books ; QNAP: your existing shared-folder location.
ARCHIVIST_MEDIA_PATH=/replace/with/existing/books
ARCHIVIST_AUDIO_HOST_PATH=/replace/with/existing/audiobooks
ARCHIVIST_COMICS_HOST_PATH=/replace/with/existing/comics

# For a trusted LAN, set 0.0.0.0 and enforce firewall restrictions.
# Prefer 127.0.0.1 with a trusted HTTPS reverse proxy.
ARCHIVIST_BIND_ADDRESS=127.0.0.1
ARCHIVIST_PORT=5056
ARCHIVIST_VERSION=dev
