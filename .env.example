# Copy to .env in the repository root and change ARCHIVIST_MEDIA_PATH.
# Use an existing absolute path on the Docker host. Do not point at your database.
# Linux/NAS: /volume1/media, /mnt/user/Media, /mnt/tank/books, etc.
# Windows Docker Desktop: use a path supported by your configured file sharing.
ARCHIVIST_MEDIA_PATH=/replace/with/an/existing/media/folder

# 127.0.0.1 is safer for local access behind a reverse proxy.
# 0.0.0.0 makes local HTTP accessible on all host interfaces; trusted LAN only.
ARCHIVIST_BIND_ADDRESS=127.0.0.1
ARCHIVIST_PORT=5056
ARCHIVIST_VERSION=dev
