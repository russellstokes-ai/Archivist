{
  "name": "archivist-mobile",
  "version": "0.9.4",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node run-tests.cjs",
    "web": "expo start --web",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "expo": "55.0.31",
    "expo-router": "~55.0.18",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-system-ui": "~55.0.22",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "expo-sharing": "~55.0.24",
    "expo-document-picker": "~55.0.17",
    "jszip": "^3.10.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-web": "~0.21.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-webview": "13.16.0",
    "react-native-unarchive": "^1.1.0",
    "expo-build-properties": "~55.0.18",
    "expo-sqlite": "~55.0.20"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2",
    "@playwright/test": "^1.55.0",
    "@types/react-dom": "~19.2.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "typescript"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
