{
  "expo": {
    "name": "Archivist",
    "slug": "archivist",
    "version": "0.9.4",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.archivist.reader"
    },
    "android": {
      "package": "app.archivist.reader",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#072632"
      },
      "versionCode": 94,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF7",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#07151C"
          }
        }
      ],
      "./plugins/withCleartextTraffic",
      [
        "expo-image-picker",
        {
          "photosPermission": "Archivist uses your selected photo only when you choose it as cover artwork.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "updates": {
      "enabled": false
    }
  }
}
